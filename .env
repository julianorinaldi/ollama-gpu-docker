OLLAMA_HOST=0.0.0.0:11434
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=mistral-nemo

# Geração de imagem no Open WebUI.
# Antes isto apontava para o AUTOMATIC1111 (engine "openai" + /sdapi/v1), que
# nunca chegou a subir. O ComfyUI tem engine própria no Open WebUI — não é a
# API da OpenAI, então não existe chave a preencher aqui.
ENABLE_IMAGE_GENERATION=True
IMAGE_GENERATION_ENGINE=comfyui
COMFYUI_BASE_URL=http://comfyui:8188
IMAGE_GENERATION_MODEL=animagine-xl-4.0-opt.safetensors
IMAGE_SIZE=896x1152
IMAGE_STEPS=30
